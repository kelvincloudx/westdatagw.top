---
import Layout from '../layouts/Layout.astro';
import PlanWorkbench from '../components/PlanWorkbench.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { ARTICLES } from '../data/articles';
import { FAQ_ITEMS } from '../data/faq';
import { AFFILIATE_URL } from '../data/plans';

const title = "西部数据官网机场 WESTDATA｜订阅套餐、节点配置与使用教程";
const description = "查看西部数据 WESTDATA 的四种公开参考套餐、流量规则、客户端配置和节点使用知识，了解订阅更新、策略组及常见连接问题。";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "西部数据官网机场 WESTDATA",
  "url": "https://westdatagw.top"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQ_ITEMS.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={title} description={description} canonicalPath="/" jsonLd={[websiteSchema, faqSchema]}>
  <!-- Screen 1: Split Hero -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="brand-pill">
          <span class="pill-dot"></span>
          <span>WESTDATA 西部数据官网机场</span>
        </div>
        <h1 class="hero-title">
          让连接更简单<br />
          <span class="highlight-text">让选择更清晰</span>
        </h1>
        <p class="hero-subtitle">
          了解 WESTDATA 网络订阅方案、流量使用方式和设备连接知识，查看套餐信息与新手配置指南。
        </p>

        <div class="hero-actions">
          <a href="/plans/" class="btn btn-primary btn-lg">浏览套餐</a>
          <a href="/start/" class="btn btn-secondary btn-lg">开始使用</a>
          <a 
            href={AFFILIATE_URL} 
            target="_blank" 
            rel="sponsored nofollow noopener" 
            class="btn btn-neon btn-lg"
          >
            前往指定订阅平台 ↗
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="spectrum-card">
          <div class="card-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="card-title">SPECTRUM OS ｜ 信号光谱示意图</span>
          </div>
          <div class="svg-wrapper">
            <svg viewBox="0 0 500 280" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="spectrumGradient" x1="0" y1="0" x2="500" y2="0" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FF657A" />
                  <stop offset="50%" stop-color="#D8FC68" />
                  <stop offset="100%" stop-color="#EAE6FF" />
                </linearGradient>
              </defs>
              <!-- Grid lines -->
              <line x1="0" y1="70" x2="500" y2="70" stroke="rgba(234, 230, 255, 0.08)" stroke-dasharray="4 4"/>
              <line x1="0" y1="140" x2="500" y2="140" stroke="rgba(234, 230, 255, 0.08)" stroke-dasharray="4 4"/>
              <line x1="0" y1="210" x2="500" y2="210" stroke="rgba(234, 230, 255, 0.08)" stroke-dasharray="4 4"/>

              <!-- Spectrum Waves -->
              <path d="M 0 140 Q 60 40, 120 140 T 240 140 T 360 140 T 480 140 L 500 140" stroke="url(#spectrumGradient)" stroke-width="3" fill="none" />
              <path d="M 0 140 Q 80 200, 160 140 T 320 140 T 480 140" stroke="#FF657A" stroke-width="2" stroke-opacity="0.6" fill="none" />
              
              <!-- Nodes -->
              <circle cx="120" cy="140" r="6" fill="#D8FC68" />
              <circle cx="240" cy="140" r="6" fill="#FF657A" />
              <circle cx="360" cy="140" r="6" fill="#EAE6FF" />

              <text x="120" y="170" fill="#A3A0C2" font-size="12" text-anchor="middle">信号波形 A</text>
              <text x="240" y="170" fill="#A3A0C2" font-size="12" text-anchor="middle">信号波形 B</text>
              <text x="360" y="170" fill="#A3A0C2" font-size="12" text-anchor="middle">信号波形 C</text>
            </svg>
          </div>
          <p class="visual-note">注：上图为抽象信号波形装饰效果图，非实时测速数据。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 2: Service Info Navigation (01, 02, 03, 04) -->
  <section class="service-nav-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">02 服务指南</span>
        <h2 class="section-title">全方位探索 WESTDATA 服务导览</h2>
        <p class="section-desc">快速获取您最关心的核心板块信息，点击对应卡片即可直接定位。</p>
      </div>

      <div class="service-grid">
        <a href="/plans/" class="service-card">
          <span class="card-num">01</span>
          <h3 class="card-title">套餐价格</h3>
          <p class="card-desc">探索基础体验版、进阶专线版、旗舰尊享版与不限时包四款参考方案。</p>

          <span class="card-link">查看套餐 ↗</span>
        </a>

        <a href="/learn/traffic-reset/" class="service-card">
          <span class="card-num">02</span>
          <h3 class="card-title">流量规则</h3>
          <p class="card-desc">理解按月重置逻辑、结算周期差异以及一次性买断不限时流量包计算方式。</p>

          <span class="card-link">了解规则 ↗</span>
        </a>

        <a href="/clients/" class="service-card">
          <span class="card-num">03</span>
          <h3 class="card-title">客户端使用</h3>
          <p class="card-desc">掌握 ClashParty、Shadowrocket 等常见代理客户端的下载、导入与环境配置。</p>

          <span class="card-link">客户端指南 ↗</span>
        </a>

        <a href="/faq/" class="service-card">
          <span class="card-num">04</span>
          <h3 class="card-title">常见问题</h3>
          <p class="card-desc">解答有关订阅更新、策略组分流、断连排查及网络环境冲突等热点疑问。</p>

          <span class="card-link">浏览 FAQ ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Screen 3: Plan Workbench -->
  <PlanWorkbench />

  <!-- Screen 4: Timeline -->
  <section class="timeline-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">04 配置流程</span>
        <h2 class="section-title">新手配置快速时间轴</h2>
        <p class="section-desc">按照五步标准化流程快速上手 WESTDATA 网络订阅，避免常见踩坑。</p>
      </div>

      <div class="timeline-stepper">
        <div class="step-item">
          <div class="step-badge">1</div>
          <h3 class="step-title">了解套餐需求</h3>
          <p class="step-desc">对照自身使用的设备数量、月度流量需求与网络场景，选择最适合的参考套餐。</p>
        </div>

        <div class="step-item">
          <div class="step-badge">2</div>
          <h3 class="step-title">确认付款页面</h3>
          <p class="step-desc">通过本站唯一指定链接进入平台购买界面，确认订单信息与售后服务条款。</p>
        </div>

        <div class="step-item">
          <div class="step-badge">3</div>
          <h3 class="step-title">获取客户端订阅</h3>
          <p class="step-desc">在个人订阅后台复制加密订阅链接（注意：推广链接并非客户端订阅配置文件）。</p>
        </div>

        <div class="step-item">
          <div class="step-badge">4</div>
          <h3 class="step-title">配置客户端软件</h3>
          <p class="step-desc">打开 ClashParty 或 Shadowrocket 等软件，粘贴订阅链接并一键同步节点信息。</p>
        </div>

        <div class="step-item">
          <div class="step-badge">5</div>
          <h3 class="step-title">检查网络连接</h3>
          <p class="step-desc">开启代理控制开关，选择合适的策略组节点，验证网络访问连通性。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 5: Diagnosis Center -->
  <section class="diagnosis-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">05 问题诊断</span>
        <h2 class="section-title">WESTDATA 问题诊断中心</h2>
        <p class="section-desc">遇到异常情况？根据分类一键调阅对应技术文章进行针对性排除。</p>
      </div>

      <div class="diag-grid">
        <div class="diag-card">
          <h3 class="diag-title">订阅与账号类</h3>
          <ul class="diag-links">
            <li><a href="/learn/traffic-reset/">流量归零与账单重置时间核对 ↗</a></li>
            <li><a href="/learn/subscription-refresh/">订阅更新失败与链接失效解决 ↗</a></li>
            <li><a href="/learn/plan-verification/">套餐权益与到期规则判定 ↗</a></li>
          </ul>
        </div>

        <div class="diag-card">
          <h3 class="diag-title">设备与客户端类</h3>
          <ul class="diag-links">
            <li><a href="/learn/policy-groups/">ClashParty 策略组无节点问题 ↗</a></li>
            <li><a href="/learn/proxy-environment/">系统代理开启后部分软件不走代理 ↗</a></li>
            <li><a href="/clients/">iOS / Windows / Android 客户端配置 ↗</a></li>
          </ul>
        </div>

        <div class="diag-card">
          <h3 class="diag-title">连接与流量类</h3>
          <ul class="diag-links">
            <li><a href="/learn/node-switching/">节点延迟高、丢包与选线指南 ↗</a></li>
            <li><a href="/learn/fault-classification/">判断本地宽带与服务端线路故障 ↗</a></li>
            <li><a href="/faq/">网络切换 Wi-Fi 后断连排查 ↗</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 6: Knowledge Articles (Horizontal Numbered List) -->
  <section class="articles-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">06 知识文章</span>
        <h2 class="section-title">WESTDATA 技术与配置导读文章</h2>
        <p class="section-desc">全量 7 篇原创深度文章，帮助您系统掌握代理分流与节点配置。</p>
      </div>

      <div class="article-numbered-list">
        {ARTICLES.map((article, index) => (
          <a href={article.url} class="article-row">
            <span class="row-num">0{index + 1}</span>
            <div class="row-content">
              <h3 class="row-title">{article.title}</h3>
              <p class="row-subtitle">{article.subtitle}</p>
            </div>
            <div class="row-meta">
              <span class="row-tag">{article.category}</span>
              <span class="row-arrow">阅读全文 ↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <TestimonialsSection />

  <!-- Screen 7: FAQ -->
  <FAQSection />

  <!-- Screen 8: Help Area (User Concerns) -->
  <section class="user-help-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">08 用户帮助</span>
        <h2 class="section-title">用户最关心的十个使用问题</h2>
        <p class="section-desc">我们拒绝编造虚假评价与测速数据，整理实用的问答与提示助您安心选购。</p>
      </div>

      <div class="help-grid">
        {FAQ_ITEMS.map((item) => (
          <div class="help-card">
            <h3 class="help-q">{item.question}</h3>
            <p class="help-a">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Styles */
  .hero-section {
    padding: 5rem 0 4rem;
    position: relative;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .brand-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    background: rgba(234, 230, 255, 0.08);
    border: 1px solid var(--border-color);
    border-radius: 50px;
    font-size: 0.85rem;
    color: var(--pastel-violet);
    margin-bottom: 1.25rem;
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    background-color: var(--neon-green);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--neon-green);
  }

  .hero-title {
    font-size: 3.2rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .highlight-text {
    background: linear-gradient(135deg, var(--coral-red) 0%, var(--neon-green) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--violet-grey);
    line-height: 1.6;
    margin-bottom: 2.2rem;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Hero Visual */
  .spectrum-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #FF5F56; }
  .dot.yellow { background: #FFBD2E; }
  .dot.green { background: #27C93F; }

  .card-title {
    font-size: 0.82rem;
    color: var(--violet-grey);
    margin-left: 0.5rem;
    font-family: monospace;
  }

  .visual-note {
    font-size: 0.78rem;
    color: rgba(163, 160, 194, 0.6);
    margin-top: 1rem;
    text-align: center;
  }

  /* Service Grid */
  .service-nav-section {
    padding: 4rem 0;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: all 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--coral-red);
    background: var(--bg-card-hover);
  }

  .card-num {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--coral-red);
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .service-card .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .service-card .card-desc {
    font-size: 0.92rem;
    color: var(--violet-grey);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .card-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neon-green);
    margin-top: auto;
  }

  /* Timeline Section */
  .timeline-section {
    padding: 5rem 0;
    background: rgba(16, 17, 39, 0.5);
  }

  .timeline-stepper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
    position: relative;
  }

  .step-item {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--coral-red);
    color: #ffffff;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .step-desc {
    font-size: 0.85rem;
    color: var(--violet-grey);
    line-height: 1.5;
  }

  /* Diagnosis Section */
  .diagnosis-section {
    padding: 5rem 0;
  }

  .diag-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .diag-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2rem;
  }

  .diag-title {
    font-size: 1.2rem;
    color: #ffffff;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .diag-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .diag-links a {
    color: var(--pastel-violet);
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .diag-links a:hover {
    color: var(--neon-green);
  }

  /* Articles Section (Horizontal Numbered) */
  .articles-section {
    padding: 5rem 0;
  }

  .article-numbered-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    transition: all 0.25s ease;
  }

  .article-row:hover {
    transform: translateX(6px);
    border-color: var(--coral-red);
    background: var(--bg-card-hover);
  }

  .row-num {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--coral-red);
    opacity: 0.8;
  }

  .row-content {
    flex: 1;
  }

  .row-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.3rem;
  }

  .row-subtitle {
    font-size: 0.88rem;
    color: var(--violet-grey);
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .row-tag {
    font-size: 0.78rem;
    padding: 0.2rem 0.65rem;
    background: rgba(234, 230, 255, 0.08);
    border-radius: 4px;
    color: var(--pastel-violet);
  }

  .row-arrow {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--neon-green);
  }

  /* Help Section */
  .user-help-section {
    padding: 5rem 0;
    background: rgba(16, 17, 39, 0.4);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .help-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
  }

  .help-q {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .help-a {
    font-size: 0.92rem;
    color: var(--violet-grey);
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .timeline-stepper {
      grid-template-columns: 1fr;
    }
    .diag-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 850px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-title {
      font-size: 2.4rem;
    }
    .help-grid {
      grid-template-columns: 1fr;
    }
    .article-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
