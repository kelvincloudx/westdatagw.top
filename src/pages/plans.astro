---
import Layout from '../layouts/Layout.astro';
import PlanWorkbench from '../components/PlanWorkbench.astro';

const title = "WESTDATA 套餐方案全览｜西部数据 15元-68元参考方案列表";
const description = "查看西部数据 WESTDATA 的 4 款公开参考套餐（基础体验版、进阶专线版、旗舰尊享版与不限时包），包含价格、流量与权益说明。";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://westdatagw.top/" },
    { "@type": "ListItem", "position": 2, "name": "套餐方案", "item": "https://westdatagw.top/plans/" }
  ]
};
---

<Layout title={title} description={description} canonicalPath="/plans/" jsonLd={breadcrumbSchema}>
  <div class="page-header container">
    <nav class="breadcrumbs">
      <a href="/">首页</a> &gt; <span>套餐方案</span>
    </nav>
    <h1 class="page-title">WESTDATA 全量参考套餐说明</h1>
    <p class="page-desc">
      提供按月结算周期套餐与一次性买断不限时流量包两类选择。请认真对照各项参考指标与核实状态。
    </p>
  </div>

  <PlanWorkbench />
</Layout>

<style>
  .page-header {
    padding: 3rem 0 1rem;
  }

  .breadcrumbs {
    font-size: 0.88rem;
    color: var(--violet-grey);
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--pastel-violet);
  }

  .page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .page-desc {
    font-size: 1.05rem;
    color: var(--violet-grey);
    max-width: 700px;
  }
</style>
