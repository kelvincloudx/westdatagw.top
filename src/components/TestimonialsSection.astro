---
const testimonials = [
  {
    tag: "配置型用户",
    title: "步骤感很强",
    content: "我比较喜欢有清晰步骤的网站，因为这样不容易出错。这个页面从套餐到使用说明的顺序比较合理，适合边看边操作，整体体验比单纯堆信息要好得多。"
  },
  {
    tag: "切换节点用户",
    title: "节点理解更直观",
    content: "以前我不太明白什么时候该切节点、为什么切了以后体验会不一样。这里对节点和连接逻辑的说明更清楚，让我知道该从哪些方向去判断问题。"
  },
  {
    tag: "桌面端用户",
    title: "文章内容更有帮助",
    content: "很多网站文章都比较空，这里相对更偏实用。尤其是关于连接检查、客户端和常见问题的内容，看得出来是按实际使用场景去组织的。"
  },
  {
    tag: "回访用户",
    title: "后续查看很方便",
    content: "我不是只看一次就离开的人，后面还会回来查问题。这个站点的导航和文章目录做得比较清楚，回头再找内容的时候速度会快很多。"
  }
];
---

<section id="testimonials-section" class="testimonials-section">
  <div class="container">
    <div class="section-header-center">
      <span class="section-tag">口碑推荐</span>
      <h2 class="section-title-centered">用户口碑评价与推荐</h2>
      <p class="section-desc-centered">
        对很多用户来说，一个好用的官网不仅要有套餐信息，更要把配置逻辑、节点选择和排查思路讲清楚。
      </p>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((item) => (
        <div class="testimonial-card">
          <div class="card-header-row">
            <span class="user-tag">{item.tag}</span>
            <div class="quote-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.75-2-2-2H4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h3c0 4-2 6-4 6v2zm14 0c3 0 7-1 7-8V5c0-1.25-.75-2-2-2h-4c-1.25 0-2 .75-2 2v6c0 1.25.75 2 2 2h3c0 4-2 6-4 6v2z"/>
              </svg>
            </div>
          </div>
          <h3 class="card-headline">{item.title}</h3>
          <p class="card-body-text">{item.content}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 5rem 0;
    background: rgba(16, 17, 39, 0.4);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header-center {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 3rem auto;
  }

  .section-title-centered {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-desc-centered {
    font-size: 1.05rem;
    color: var(--violet-grey);
    line-height: 1.6;
    margin: 0 auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .testimonial-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-active);
    background: var(--bg-card-hover);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .user-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--neon-green);
    background: rgba(216, 252, 104, 0.1);
    border: 1px solid rgba(216, 252, 104, 0.25);
    padding: 0.2rem 0.65rem;
    border-radius: 50px;
    letter-spacing: 0.02em;
  }

  .quote-icon {
    color: var(--coral-red);
    opacity: 0.6;
    display: flex;
    align-items: center;
  }

  .card-headline {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .card-body-text {
    font-size: 0.92rem;
    color: var(--pastel-violet);
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
    .section-title-centered {
      font-size: 1.75rem;
    }
    .testimonial-card {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
